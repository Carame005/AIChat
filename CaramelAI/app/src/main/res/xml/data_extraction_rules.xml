<?xml version="1.0" encoding="utf-8"?>
<!--
   Exclude settings (API key / server URL) from cloud backup and device transfer.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/caramel_settings.preferences_pb" />
        <exclude domain="root" path="datastore/caramel_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/caramel_settings.preferences_pb" />
        <exclude domain="root" path="datastore/caramel_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
