    <string name="settings_global_behavior_hint">Instructions applied to every chat. Use this for overall tone (romantic, NSFW, SFW, shorter replies, etc.).</string>
    <string name="settings_global_behavior_placeholder">e.g. Lean romantic and allow NSFW if the user starts it. Keep the character consistent.</string>
    <string name="settings_generation">Generation</string>
    <string name="settings_temperature">Temperature</string>
    <string name="settings_temperature_desc">Creativity. Higher = more creative/unpredictable; lower = more coherent and repetitive.</string>
    <string name="settings_top_p">Top P</string>
    <string name="settings_top_p_desc">Nucleus sampling. Higher allows more word variety; lower sticks to likely options.</string>
    <string name="settings_top_k">Top K</string>
    <string name="settings_top_k_desc">Limit sampling to the K most likely tokens. 0 or high = more diversity; low = more predictable.</string>
    <string name="settings_min_p">Min P</string>
    <string name="settings_min_p_desc">Relative minimum threshold. Filters unlikely tokens. Higher = safer, less weird replies.</string>
    <string name="settings_repeat_penalty">Repeat penalty</string>
    <string name="settings_repeat_penalty_desc">Penalizes repetition. Higher = fewer loops; too high can sound forced.</string>
    <string name="settings_max_tokens">Max tokens (per reply)</string>
    <string name="settings_max_tokens_desc">Cap on tokens the bot can generate in ONE message. Not full chat size. Raise for longer replies (up to 4096). In server logs this is n_gen / eval tokens, not n_tokens.</string>
    <string name="settings_context_size">Context size (chat memory)</string>
    <string name="settings_context_size_desc">Total tokens for prompt + history + reply that fit in the slot. Must match llama-server -c. In logs this is n_tokens. Higher = more history, more VRAM.</string>
    <string name="settings_reset_generation">Reset generation defaults</string>
