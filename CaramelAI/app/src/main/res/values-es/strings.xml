    <string name="settings_model_q4_desc">Más ligero; mejor en portátil / poca VRAM.</string>
    <string name="settings_model_q5_name">Chaos Unknown 12B · Q5</string>
    <string name="settings_model_q5_desc">Más calidad; pensado para sobremesa (p. ej. 3060 12 GB).</string>
    <string name="settings_global_behavior">Comportamiento global</string>
    <string name="settings_global_behavior_hint">Instrucciones que se aplican a todos los chats. Úsalo para orientar el tono general (romántico, NSFW, SFW, más corto, etc.).</string>
    <string name="settings_global_behavior_placeholder">Ej.: Inclina la historia hacia lo romántico y acepta contenido NSFW si el usuario lo inicia. Mantén el personaje coherente.</string>
    <string name="settings_generation">Generación</string>
    <string name="settings_temperature">Temperature</string>
    <string name="settings_temperature_desc">Controla la creatividad. Más alto = respuestas más creativas e impredecibles; más bajo = más coherentes y repetitivas.</string>
    <string name="settings_top_p">Top P</string>
    <string name="settings_top_p_desc">Núcleo de probabilidad. Valores altos permiten más variedad de palabras; valores bajos se centran en las opciones más probables.</string>
    <string name="settings_top_k">Top K</string>
    <string name="settings_top_k_desc">Limita el muestreo a las K palabras más probables. 0 o valores altos = más diversidad; valores bajos = más predecible.</string>
    <string name="settings_min_p">Min P</string>
    <string name="settings_min_p_desc">Umbral mínimo relativo. Filtra tokens poco probables. Más alto = respuestas más seguras y menos raras.</string>
    <string name="settings_repeat_penalty">Repeat penalty</string>
    <string name="settings_repeat_penalty_desc">Penaliza repetir lo mismo. Más alto = menos bucles y repeticiones; demasiado alto puede sonar forzado.</string>
    <string name="settings_max_tokens">Max tokens (por respuesta)</string>
    <string name="settings_max_tokens_desc">Tope de tokens que el bot puede generar en UN mensaje. No es el tamaño del chat completo. Sube esto si quieres respuestas más largas (hasta 4096). En los logs del servidor esto es n_gen / eval tokens, no n_tokens.</string>
    <string name="settings_context_size">Context size (memoria del chat)</string>
    <string name="settings_context_size_desc">Tokens totales del prompt + historial + respuesta que caben en el slot. Debe coincidir con llama-server -c. En los logs es n_tokens (p. ej. 517 o 1389). Más alto = más historial, más VRAM.</string>
